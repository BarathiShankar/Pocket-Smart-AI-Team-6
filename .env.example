# PocketSmart AI Environment Configuration

# Flask Secret Key for Sessions
SECRET_KEY=pocketsmart-luxury-gold-secure-secret-key-2026

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Application Port
PORT=5000

# Database Configuration (Local SQLite default, or AWS DynamoDB)
DATABASE_PATH=data/pocketsmart.db

# AWS Cloud Target Configuration (Optional / Production)
USE_AWS=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=
